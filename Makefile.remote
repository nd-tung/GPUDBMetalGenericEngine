# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
PROJECT_NAME  = MetalGenericDBEngine
SOURCE_DIR    = src
KERNEL_DIR    = kernels
METAL_CPP_DIR = third_party/metal-cpp
DATA_DIR      = data
BUILD_DIR     = build
BIN_DIR       = $(BUILD_DIR)/bin
OBJ_DIR       = $(BUILD_DIR)/obj

# Compiler and flags — use xcrun to pick correct SDK/sysroot
CXX      = xcrun -sdk macosx clang++
MACOSX_MIN ?= 14.0
CXXFLAGS = -std=c++20 -Wall -Wextra -Wshadow -O2 -mmacosx-version-min=$(MACOSX_MIN) -MMD -MP

# DuckDB (embedded library via Homebrew)
DUCKDB_PREFIX ?= $(shell brew --prefix duckdb 2>/dev/null || echo /opt/homebrew)
DUCKDB_INCLUDE = -I$(DUCKDB_PREFIX)/include
DUCKDB_LIB     = -L$(DUCKDB_PREFIX)/lib -lduckdb

# Include paths
INCLUDES = -I$(METAL_CPP_DIR) \
           -Ithird_party \
           -I$(SOURCE_DIR)/Engine/Executor \
           -I$(SOURCE_DIR)/Engine/Executor/Operators \
           -I$(SOURCE_DIR)/Engine/Planner \
           -I$(SOURCE_DIR)/Engine/Storage \
           -I$(SOURCE_DIR)/Engine/Storage/GPU \
           -I$(SOURCE_DIR)/Engine/Utils \
           $(DUCKDB_INCLUDE)

FRAMEWORKS = -framework Metal -framework Foundation -framework QuartzCore

# Source files (recursive — matches existing Makefile)
SOURCES = $(shell find $(SOURCE_DIR) -name '*.cpp')
OBJECTS = $(SOURCES:$(SOURCE_DIR)/%.cpp=$(OBJ_DIR)/%.o)
DEPS    = $(OBJECTS:.o=.d)
TARGET  = $(BIN_DIR)/$(PROJECT_NAME)

KERNEL_METALLIB = $(BUILD_DIR)/kernels.metallib

# Queries and scale factors understood by the binary
QUERIES = q01 q02 q03 q04 q05 q06 q07 q08 q09 q10 q11 q12 q13 q14 q15 q16 q17 q18 q19 q20 q21 q22
SCALE_FACTORS = sf1 sf10

# ---------------------------------------------------------------------------
# Remote host  (set via environment variables)
#   export REMOTE_USER=... REMOTE_HOST=... REMOTE_PATH=...
# ---------------------------------------------------------------------------
REMOTE_USER ?= $(error REMOTE_USER is not set — export it or pass on the command line)
REMOTE_HOST ?= $(error REMOTE_HOST is not set — export it or pass on the command line)
REMOTE_PATH_GENERIC ?= $(error REMOTE_PATH_GENERIC is not set — export it or pass on the command line)
REMOTE      = $(REMOTE_USER)@$(REMOTE_HOST)
SSH         = ssh $(REMOTE)
RSYNC       = rsync -avz --delete

# ---------------------------------------------------------------------------
# Build  (C++ only — no Metal compilation)
# ---------------------------------------------------------------------------
.PHONY: all rebuild clean check-metallib

all: check-metallib $(TARGET)

rebuild: clean all

# Verify the pre-compiled metallib is present before building.
check-metallib:
	@if [ ! -f $(KERNEL_METALLIB) ]; then \
	  echo "ERROR: $(KERNEL_METALLIB) not found."; \
	  echo "       Build it locally (make) and copy it here, or pull from git."; \
	  exit 1; \
	fi
	@echo "Using pre-compiled $(KERNEL_METALLIB)"

$(TARGET): $(OBJECTS) | $(BIN_DIR)
	@echo "Linking $(PROJECT_NAME)..."
	$(CXX) $(CXXFLAGS) $(OBJECTS) $(FRAMEWORKS) $(DUCKDB_LIB) -o $@
	@echo "Build complete: $@"

$(OBJ_DIR)/%.o: $(SOURCE_DIR)/%.cpp | $(OBJ_DIR)
	@echo "Compiling $<..."
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(BIN_DIR) $(OBJ_DIR) $(BUILD_DIR):
	@mkdir -p $@

clean:
	@echo "Cleaning build artifacts (preserving metallib)..."
	@rm -rf $(OBJ_DIR) $(BIN_DIR)
	@echo "Clean complete"

# Auto-generated dependency includes
-include $(DEPS)

# ---------------------------------------------------------------------------
# Run  —  make -f Makefile.remote run SF=sf1 Q=queries/q06.sql
# ---------------------------------------------------------------------------
.PHONY: run

SF ?=
Q  ?=
run: all
	@./$(TARGET) $(SF) $(Q)

# ---------------------------------------------------------------------------
# Convenience per-scale-factor targets
# ---------------------------------------------------------------------------
.PHONY: run-sf1 run-sf10
run-sf1 run-sf10: run-%: all
	@./$(TARGET) $*

# ---------------------------------------------------------------------------
# Run all tests  —  make -f Makefile.remote test
# ---------------------------------------------------------------------------
.PHONY: test
test: all
	@scripts/run_all_tests.sh

# ---------------------------------------------------------------------------
# Verify project structure
# ---------------------------------------------------------------------------
.PHONY: check
check:
	@echo "Checking project structure..."
	@test -f $(SOURCE_DIR)/main.cpp              || (echo "ERROR: $(SOURCE_DIR)/main.cpp not found" && exit 1)
	@test -f $(KERNEL_METALLIB)                  || (echo "ERROR: $(KERNEL_METALLIB) not found" && exit 1)
	@test -d $(METAL_CPP_DIR)                    || (echo "ERROR: metal-cpp not found" && exit 1)
	@for sf in SF-1 SF-10; do \
	  if [ -d $(DATA_DIR)/$$sf ]; then \
	    echo "  $$sf: OK"; \
	  else \
	    echo "  $$sf: not found (run scripts/create_tpch_data.sh)"; \
	  fi; \
	done
	@echo "Check complete"

# ---------------------------------------------------------------------------
# Remote deployment  (run FROM your local machine)
# ---------------------------------------------------------------------------
.PHONY: sync deploy remote-run remote-build remote-clean remote-check remote-test

# Sync source, kernels, metallib, headers, queries, scripts, and this Makefile.
sync:
	@echo "Syncing project to $(REMOTE):$(REMOTE_PATH_GENERIC) ..."
	$(RSYNC) \
	  --include='build/'                \
	  --include='build/kernels.metallib' \
	  --exclude='build/**'               \
	  --exclude='.git/'                  \
	  --exclude='temp_tpch/'             \
	  --exclude='results/'               \
	  --exclude='benchmark_results/'     \
	  --exclude='data/'                  \
	  --exclude='*.bak'                  \
	  --exclude='*.bak2'                 \
	  --exclude='.DS_Store'              \
	  --exclude='*.xcodeproj/'           \
	  ./ $(REMOTE):$(REMOTE_PATH_GENERIC)/
	@echo "Sync complete."

# Sync + build on remote.
deploy: sync
	@echo "Building on remote..."
	$(SSH) 'cd $(REMOTE_PATH_GENERIC) && make -f Makefile.remote'

# Sync + build + run on remote.
remote-run: deploy
	@echo "Running on remote..."
	$(SSH) 'cd $(REMOTE_PATH_GENERIC) && make -f Makefile.remote run SF=$(SF) Q=$(Q)'

remote-build:
	$(SSH) 'cd $(REMOTE_PATH_GENERIC) && make -f Makefile.remote'

remote-clean:
	$(SSH) 'cd $(REMOTE_PATH_GENERIC) && make -f Makefile.remote clean'

remote-check:
	$(SSH) 'cd $(REMOTE_PATH_GENERIC) && make -f Makefile.remote check'

remote-test: deploy
	@echo "Running tests on remote..."
	$(SSH) 'cd $(REMOTE_PATH_GENERIC) && make -f Makefile.remote test'

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
.PHONY: help
help:
	@echo "MetalGenericDBEngine (Remote)"
	@echo "=============================="
	@echo ""
	@echo "Local build (on remote machine directly):"
	@echo "  make -f Makefile.remote              Build binary (requires pre-compiled metallib)"
	@echo "  make -f Makefile.remote rebuild       Clean + build"
	@echo "  make -f Makefile.remote clean         Remove obj/bin (keeps metallib)"
	@echo "  make -f Makefile.remote run            Build + run (default query)"
	@echo "  make -f Makefile.remote run SF=sf10 Q=queries/q06.sql"
	@echo "  make -f Makefile.remote test           Run all SQL tests"
	@echo ""
	@echo "Deploy from local to remote:"
	@echo "  make -f Makefile.remote sync           Sync files to remote"
	@echo "  make -f Makefile.remote deploy          Sync + build on remote"
	@echo "  make -f Makefile.remote remote-run      Sync + build + run on remote"
	@echo "  make -f Makefile.remote remote-run SF=sf10 Q=queries/q01.sql"
	@echo "  make -f Makefile.remote remote-build    Build on remote (no sync)"
	@echo "  make -f Makefile.remote remote-clean    Clean on remote"
	@echo "  make -f Makefile.remote remote-check    Check structure on remote"
	@echo "  make -f Makefile.remote remote-test     Sync + build + run all tests"
	@echo ""
	@echo "Other:"
	@echo "  make -f Makefile.remote check          Verify project structure"
	@echo "  make -f Makefile.remote help            Show this message"
